{
  "name": "dodoc-electron",
  "productName": "do•doc",
  "version": "14.0.7-alpha.3",
  "description": "do•doc Electron wrapper",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "debug": "electron --inspect=5858 . -- --debug",
    "debug-verbose": "electron --inspect=5858 . -- --debug --verbose",
    "debug-lr": "electronmon --inspect=5858 . -- --debug --livereload",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -p always",
    "dist:win-store": "electron-builder --win appx",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": "^24.21.0",
    "npm": "*"
  },
  "electronmon": {
    "patterns": [
      "!../client/**",
      "!../tokens.json"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^44.7.1",
    "electron-builder": "^26.17.0",
    "electronmon": "^2.0.4"
  }
}
