{
  "name": "dodoc",
  "productName": "do•doc",
  "version": "14.0.7-alpha.5",
  "description": "do•doc is a documentation tool for creativity.",
  "author": "L’Atelier des Chercheurs <https://latelier-des-chercheurs.fr/>",
  "homepage": "https://github.com/l-atelier-des-chercheurs/dodoc#readme",
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/l-atelier-des-chercheurs/dodoc.git"
  },
  "bugs": {
    "url": "https://github.com/l-atelier-des-chercheurs/dodoc/issues"
  },
  "scripts": {
    "start": "node .",
    "debug": "node . --inspect=5858 -- --debug",
    "debug-verbose": "node . --inspect=5858 -- --debug --verbose",
    "debug-lr": "node . --inspect=5858 -- --debug --livereload",
    "install:electron": "adc-electron install",
    "electron": "adc-electron start",
    "electron:debug": "adc-electron start --inspect=5858 -- --debug",
    "electron:debug-verbose": "adc-electron start --inspect=5858 -- --debug --verbose",
    "electron:debug-lr": "adc-electron watch --inspect=5858 -- --debug --livereload",
    "electron:pack": "adc-electron dist --dir",
    "electron:dist": "adc-electron dist -p always",
    "electron:dist-win-store": "adc-electron dist --win appx",
    "preversion": "npm run build --prefix client && git add client/dist",
    "postversion": "git push --follow-tags",
    "setup-https": "node scripts/setup-https-certs.js"
  },
  "engines": {
    "node": "^24.22.0",
    "npm": "*"
  },
  "dependencies": {
    "adc-core": "git+https://github.com/l-atelier-des-chercheurs/adc-core.git#semver:^0.2.0"
  }
}
